GaMD equilibration simulation
 &cntrl
    imin=0,        ! No minimization
    irest=0,       ! This IS a new MD simulation
    ntx=1,         ! read coordinates only

    ! Temperature control
    ntt=3,         ! Langevin dynamics
    gamma_ln=1.0,  ! Friction coefficient (ps^-1)
    tempi=300.0,   ! Initial temperature
    temp0=300.0,   ! Target temperature
    ig=-1,         ! random seed

    ! Potential energy control
    cut=8.0,      ! nonbonded cutoff, in angstroms

    ! MD settings
    nstlim=6000000, ! simulation length
    dt=0.002,      ! time step (ps)

    ! SHAKE
    ntc=2,         ! Constrain bonds containing hydrogen
    ntf=1,         ! Complete force evaluation; check LiGaMD/TI compatibility for this build

    ! Control how often information is printed
    ntpr=1000,     ! Print energies every 1000 steps
    ntwx=1000,     ! Print coordinates every 1000 steps to the trajectory
    ntwr=2500,    ! Print a restart file every 2500 steps
    ntxo=2,        ! Write NetCDF format
    ioutfm=1,      ! Write NetCDF format

    ! Wrap coordinates
    iwrap=1,

    ! Constant pressure control
    barostat=1,    ! Berendsen
    ntp=1,         ! isotropic
    pres0=1.0,     ! Target external pressure, in bar
    taup=0.5,      ! Berendsen coupling constant (ps)

    ! GaMD parameters
    igamd = 11, iE = 1, irest_gamd = 0,
    ntcmd = 2000000, nteb = 4000000, ntave = 400000,
    ntcmdprep = 400000, ntebprep = 1200000,
    sigma0P = 4.0, sigma0D = 6.0, iEP=2, iED=1,
    ibblig=1,
    atom_p=__FILL_PROTEIN_REFERENCE_ATOM__,
    atom_l=__FILL_LIGAND_INTERNAL_ATOM__,
    dblig = 5.0,
    gti_cpu_output = 0, gti_add_sc = 1,
    icfe = 1,
    ifsc = 1,
    nlig = 6,
    timask1 = ':239',
    scmask1 = ':239',
    timask2 = '',
    scmask2='',
 /
