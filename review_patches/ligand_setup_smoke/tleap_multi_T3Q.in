# ============================================================
# tleap_multi_T3Q.in
# SeNMT + SAM (辅因子) + N×T3Q (随机溶剂配体)
# ============================================================

# --- 力场 ---
source leaprc.protein.ff19SB
source leaprc.gaff2
source leaprc.water.tip3p

# --- 配体参数 ---
loadamberparams SAM.frcmod
loadamberparams T3Q_ante.frcmod

# --- 加载分子 ---
# 蛋白
rec = loadpdb "E:/Desktop/website/review_patches/ligand_setup_smoke/synthetic_protein.pdb"

# SAM 辅因子（已对齐到口袋）
SAM = loadmol2 "E:/Desktop/website/review_patches/ligand_setup_smoke/synthetic_SAM.mol2"

# T3Q 配体模板
T3Q = loadmol2 "E:/Desktop/website/review_patches/ligand_setup_smoke/synthetic_T3Q.mol2"

# --- 合并体系 ---
T3Q_pos1 = copy T3Q
translate T3Q_pos1 { -12.203 42.044 21.641 }
T3Q_pos2 = copy T3Q
translate T3Q_pos2 { 8.703 -32.087 -32.090 }

complex = combine {rec SAM T3Q_pos1 T3Q_pos2}

# --- 溶剂化 (八面体盒子) ---
solvateoct complex TIP3PBOX 12.0

# --- 中和 ---
addions complex Na+ 0
addions complex Cl- 0

# --- 保存 ---
saveamberparm complex SeNMT_SAM_multiT3Q.parm7 SeNMT_SAM_multiT3Q.rst7
savepdb complex SeNMT_SAM_multiT3Q.pdb

quit
